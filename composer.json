{
  "name": "wexample/symfony-testing",
  "description": "Testing helpers for Symfony / PhpUnit",
  "type": "library",
  "license": "MIT",
  "version": "7.0.4",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTesting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyTesting\\Tests\\Fixtures\\": "tests/Fixtures/",
      "Wexample\\SymfonyTesting\\Tests\\Integration\\": "tests/Integration/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "wexample/php-date": ">=2.1.0",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-template": ">=2.1.0",
    "symfony/browser-kit": "^7.4 || ^8.0",
    "symfony/css-selector": "^7.4 || ^8.0",
    "symfony/dom-crawler": "^7.4 || ^8.0",
    "symfony/property-access": "^7.4 || ^8.0",
    "symfony/yaml": "^7.4 || ^8.0",
    "wexample/php-bpmn": ">=2.0.0",
    "symfony/twig-bundle": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12 || ^13",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "doctrine/orm": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "test"
    }
  }
}