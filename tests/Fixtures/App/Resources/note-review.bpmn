<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="note_review_definitions" targetNamespace="https://wexample.com/bpmn">
  <bpmn:process id="note_review" name="Note review" isExecutable="false">
    <bpmn:laneSet id="note_review_lanes">
      <bpmn:lane id="writer" name="Writer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="reviewer" name="Reviewer">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verdict</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="platform" name="Platform">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="A member has something to say"/>
    <bpmn:userTask id="write" name="Write a note"/>
    <bpmn:userTask id="review" name="Review the note"/>
    <bpmn:exclusiveGateway id="verdict" name="Approved?" default="flow_rejected"/>
    <bpmn:sendTask id="notify" name="Tell the writer"/>
    <bpmn:userTask id="read_verdict" name="Read the verdict"/>
    <bpmn:endEvent id="approved" name="Approved"/>
    <bpmn:userTask id="revise" name="Revise the note"/>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="write"/>
    <bpmn:sequenceFlow id="flow_written" sourceRef="write" targetRef="review"/>
    <bpmn:sequenceFlow id="flow_reviewed" sourceRef="review" targetRef="verdict"/>
    <bpmn:sequenceFlow id="flow_approved" sourceRef="verdict" targetRef="notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_notified" sourceRef="notify" targetRef="read_verdict"/>
    <bpmn:sequenceFlow id="flow_read" sourceRef="read_verdict" targetRef="approved"/>
    <bpmn:sequenceFlow id="flow_rejected" sourceRef="verdict" targetRef="revise"/>
    <bpmn:sequenceFlow id="flow_revised" sourceRef="revise" targetRef="review"/>
  </bpmn:process>
</bpmn:definitions>
